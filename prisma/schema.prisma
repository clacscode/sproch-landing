// Schema Prisma para SPROCh
// Base de datos: MySQL / MariaDB (hosting compartido — hPanel/Hostinger).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum ArticleType {
  NEWS
  PATIENT
}

enum EventCategory {
  CURSO
  CONGRESO
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum RegistrationStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  hashedPassword String?
  role           Role           @default(USER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  accounts       Account[]
  sessions       Session[]
  news           News[]
  registrations  Registration[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model News {
  id          String      @id @default(cuid())
  type        ArticleType @default(NEWS)
  slug        String      @unique
  title       String      @db.VarChar(255)
  excerpt     String      @db.VarChar(512)
  content     Json
  coverImage  String?     @db.VarChar(512)
  status      NewsStatus  @default(DRAFT)
  publishedAt DateTime?
  // MySQL no soporta arrays escalares: las etiquetas van como array JSON.
  tags        Json
  /** Byline mostrado en el sitio (texto libre, ej. "Equipo SPROCh"). */
  authorName  String?
  authorId    String?
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type, status, publishedAt])
}

model Event {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String         @db.VarChar(255)
  summary         String         @db.VarChar(512)
  content         Json
  startDate       DateTime
  endDate         DateTime
  location        String         @db.VarChar(255)
  coverImage      String?        @db.VarChar(512)
  capacity        Int?
  priceCLP        Int            @default(0)
  priceFrom       Boolean        @default(false)
  hidePrice       Boolean        @default(false)
  registrationUrl String?        @db.VarChar(512)
  featured        Boolean        @default(false)
  // Sub-entidades estructuradas (volumen bajo → columnas JSON, editadas con campos repetibles en el admin):
  // speakers: { name, country?, bio?, avatar? }[]
  // sponsors: { name, logo?, url?, tier? }[]
  // program:  { day, items: { time, title }[] }[]
  // Sin @default (MariaDB no admite default en JSON): la app siempre escribe estos campos.
  speakers        Json
  sponsors        Json
  program         Json
  category        EventCategory
  status          EventStatus    @default(DRAFT)
  registrations   Registration[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, startDate])
}

model Registration {
  id                  String             @id @default(cuid())
  eventId             String
  userId              String
  status              RegistrationStatus @default(PENDING)
  amountCLP           Int
  transbankToken      String?            @unique
  transbankBuyOrder   String?            @unique
  paidAt              DateTime?
  event               Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([eventId, userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}
