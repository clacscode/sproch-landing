# --- Sitio ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Analítica (Google Analytics 4) ---
# Vacío => no se carga ningún script de medición.
# Producción: pegar el Measurement ID del stream web (formato G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=""

# --- Base de datos (MySQL / MariaDB) ---
# Hosting compartido (hPanel/Hostinger). Una sola cadena de conexión.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# --- Auth.js (panel admin) ---
# Genera con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Admin único (se siembra con `npm run db:seed`)
ADMIN_EMAIL="admin@sproch.cl"
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_NAME="Administrador SPROCh"

# --- Server Actions (clave de cifrado estable) ---
# OBLIGATORIO en self-hosting (Hostinger Node). Sin esto, Next.js genera una
# clave aleatoria en CADA build, lo que invalida las Server Actions de cualquier
# pestaña abierta de un deploy anterior => "Failed to find Server Action".
# Fíjala UNA vez y nunca la cambies. Genera con: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# --- Subida de imágenes (disco local) ---
# Directorio bajo /public donde el panel guarda archivos. En producción,
# montar un volumen persistente (no funciona en serverless efímero).
UPLOAD_DIR="public/uploads"
UPLOAD_MAX_MB="6"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="SPROCh <no-reply@sproch.cl>"
CONTACT_INBOX="contacto@sproch.cl"

# --- WebPay (Transbank) ---
# Vacío => UI muestra "Inscripción próximamente disponible"
# Sandbox: WEBPAY_ENV=integration y credenciales públicas de Transbank
# Producción: requieren afiliación comercial y credenciales reales
WEBPAY_ENV="integration"
WEBPAY_COMMERCE_CODE=""
WEBPAY_API_KEY=""
